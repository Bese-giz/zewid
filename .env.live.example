# Copy to .env.live.local only for live catalog import and account checks.
# Keep .env.local in sandbox mode. Both local secret files are ignored by Git.
# Add these same variables to Vercel Production only; mark both secrets Sensitive.
STRIPE_MODE=live
STRIPE_SECRET_KEY=
CHECKOUT_BASE_URL=https://www.zewid.com
# Use the signing secret for https://www.zewid.com/api/stripe/webhook in Stripe live mode.
# The local CLI signing secret does not belong here.
STRIPE_WEBHOOK_SECRET=

# Service Points v5 key from PostNord Developer. Add to Vercel Production as Secret.
POSTNORD_API_KEY=
