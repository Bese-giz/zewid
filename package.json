{
  "name": "zewid-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "stripe:sync": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/sync-stripe.mts",
    "stripe:listen": "node --env-file=.env.local scripts/stripe-listen.mts",
    "stripe:methods": "node --env-file=.env.local scripts/stripe-payment-methods.mts",
    "stripe:sync:live": "node --experimental-strip-types --env-file=.env.live.local scripts/sync-stripe.mts --live",
    "stripe:methods:live": "node --env-file=.env.live.local scripts/stripe-payment-methods.mts"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "devDependencies": {
    "@stripe/cli": "^1.53.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
