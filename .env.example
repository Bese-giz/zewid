# Keep sandbox values in .env.local. Live values belong in Vercel Production.
# This file intentionally contains no credentials. Never use NEXT_PUBLIC_ for secrets.
STRIPE_MODE=sandbox
STRIPE_SECRET_KEY=

# Local checkout redirects. Use the real HTTPS origin when deploying.
CHECKOUT_BASE_URL=http://localhost:3000

# Signing secret from Stripe CLI locally, or the endpoint in the matching Stripe mode.
STRIPE_WEBHOOK_SECRET=
